# Kaggle data and large files stay out of git. See data/README.md.
data/*.csv
data/processed/
data/auxiliary/*
!data/auxiliary/sg-cpi.csv
!data/auxiliary/sg-tertiary-institutions.csv

# Per run validation predictions are large. Rows in results/runs and the
# combined results/results.csv are committed.
results/predictions/
submissions/

# Saved model weights are large binaries; rebuild them with
# scripts/save_final_model.py. See models/README.md.
models/*
!models/README.md

# Local build output
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.codex-build/
.chart-data-*/
*.inspect.ndjson
*.zip
.DS_Store
.venv/
venv/

# Tests stay local
tests/

# Local Member B artifacts; reports, figures and curve CSVs remain trackable.
data/kaggle_download/
tmp/
*.joblib
results/member_b/**/validation_predictions.csv
results/member_b/**/test_predictions.csv
results/member_b/**/fit_ids.csv
results/member_b/**/holdout_truth.csv
results/member_b/**/random5_predictions.parquet
